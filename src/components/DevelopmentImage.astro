---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../data/types';
import type { Translation } from '../i18n/bg';
const {
  src,
  copy,
  alt,
  caption,
  loading = 'lazy',
} = Astro.props as {
  src: ImageMetadata;
  locale: Locale;
  copy: Translation;
  alt: string;
  caption?: string;
  loading?: 'lazy' | 'eager';
};
---

<figure class="development-image">
  <Image
    src={src}
    alt={alt}
    width={src.width}
    height={src.height}
    loading={loading}
  />
  <figcaption>
    <span>{copy.ui.illustration}</span>
    {caption && <>{caption}</>}
  </figcaption>
</figure>
<style>
  .development-image {
    margin: 0;
  }
  .development-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .development-image figcaption {
    font-size: 0.75rem;
    color: var(--muted);
    padding-top: 0.6rem;
  }
  .development-image figcaption span {
    color: var(--moss);
    font-weight: 700;
    margin-right: 0.5rem;
  }
</style>
