---
import type { Locale } from '../data/types';
import { pathFor, type PageKey } from '../lib/routes';
import type { Translation } from '../i18n/bg';
import { Phone, ArrowUpRight } from '@lucide/astro';
import NestMark from './NestMark.astro';

interface Props {
  locale: Locale;
  page: PageKey;
  copy: Translation;
}

const { locale, page, copy } = Astro.props;
const other = locale === 'bg' ? 'en' : 'bg';
const brandName = copy.home.brand;

const navItems = [
  { key: 'accommodation', label: copy.nav.accommodation },
  { key: 'gallery', label: copy.nav.gallery },
  { key: 'location', label: copy.nav.location },
  { key: 'contact', label: copy.nav.contact },
] as const;
---

<a class="skip-link" href="#main">
  {copy.ui.skip}
</a>

<header class="site-header">
  <div class="container header-inner">
    <a
      class="wordmark"
      href={pathFor('home', locale) || '/'}
      aria-label={copy.header.wordmarkAria}
    >
      <NestMark size={44} class="wordmark-mark" />
      <span class="wordmark-text">
        <span class="wordmark-title">{brandName}</span>
        <small class="wordmark-sub">{copy.header.wordmarkSub}</small>
      </span>
    </a>

    <!-- Mobile Navigation (details/summary for no-JS fallback + JS enhanced) -->
    <details class="mobile-nav">
      <summary aria-label={copy.ui.menu} aria-expanded="false">
        <span class="menu-label">{copy.ui.menu}</span>
      </summary>
      <nav aria-label={copy.header.mobileNavAria}>
        <div class="mobile-nav-primary">
          <a
            href={pathFor('home', locale)}
            class:list={{ 'is-active': page === 'home' }}
          >
            {copy.nav.home}
          </a>
          {navItems.map((item) => (
            <a
              href={pathFor(item.key, locale)}
              class:list={{ 'is-active': page === item.key }}
            >
              {item.label}
            </a>
          ))}
          <a href={pathFor('booking', locale)} class="mobile-booking-link">
            <span>{copy.ui.bookingCta}</span>
            <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
          </a>
        </div>

        <div class="mobile-nav-divider"></div>

        <div class="mobile-nav-secondary">
          <a class="mobile-call-link" href="tel:+359877116050">
            <Phone size={16} stroke-width={2} aria-hidden="true" />
            <span>+359 877 116 050</span>
          </a>
          <a class="language" href={pathFor(page, other)} lang={other}>
            {copy.header.langSwitchLabel}
          </a>
          <div class="mobile-ota-links">
            <a
              href="https://www.booking.com/hotel/bg/bungala-gnezdoto-bungalows-the-nest.bg.html"
              target="_blank"
              rel="noopener noreferrer"
            >
              Booking.com
              <ArrowUpRight size={14} stroke-width={2} aria-hidden="true" />
            </a>
            <a
              href="https://www.airbnb.com/rooms/1518207915595474183"
              target="_blank"
              rel="noopener noreferrer"
            >
              Airbnb
              <ArrowUpRight size={14} stroke-width={2} aria-hidden="true" />
            </a>
            <a
              href="https://www.facebook.com/bungalagnezdoto/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Facebook
              <ArrowUpRight size={14} stroke-width={2} aria-hidden="true" />
            </a>
          </div>
        </div>
      </nav>
    </details>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label={copy.header.desktopNavAria}>
      <div class="nav-links">
        {navItems.map((item) => (
          <a
            class:list={['nav-link', { 'list-active': page === item.key }]}
            href={pathFor(item.key, locale)}
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="nav-actions">
        <a
          class="language-switch language"
          href={pathFor(page, other)}
          lang={other}
        >
          {copy.header.langSwitchLabel}
        </a>

        <a class="btn btn-primary header-cta" href={pathFor('booking', locale)}>
          <span>{copy.ui.bookingCta}</span>
          <ArrowUpRight
            class="cta-arrow"
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  document.querySelectorAll('.mobile-nav').forEach((details) => {
    const summary = details.querySelector('summary');
    details.addEventListener('toggle', () => {
      summary?.setAttribute('aria-expanded', String(details.open));
      if (details.open) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    });

    details.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) {
        details.open = false;
        summary?.focus();
      }
    });

    // Close menu when clicking outside or on a navigation link
    details.querySelectorAll('nav a').forEach((link) => {
      link.addEventListener('click', () => {
        details.open = false;
      });
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
    gap: 1.5rem;
    padding-inline: 0;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    line-height: 1;
  }

  .wordmark :global(.nest-mark) {
    --nest-mark-size: 2.65rem;
  }

  .wordmark-text {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  .wordmark-title {
    font-family: var(--font-heading);
    font-weight: 650;
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--forest);
  }

  .wordmark-sub {
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 550;
    transition: color 0.2s ease;
    position: relative;
    padding: 0.45rem 0;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.list-active {
    color: var(--forest);
    font-weight: 650;
  }

  .nav-link.list-active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--forest);
    border-radius: 1px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .language-switch {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm, 4px);
    border: 1px solid var(--line);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .language-switch:hover {
    color: var(--forest);
    border-color: color-mix(in srgb, var(--forest) 40%, var(--line));
    background: var(--paper-deep);
  }

  .header-cta {
    min-height: 2.45rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.86rem;
    border-radius: var(--radius, 8px);
  }

  .cta-arrow {
    transition: transform 0.2s ease;
  }

  .header-cta:hover .cta-arrow {
    transform: translate(2px, -2px);
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    background: var(--forest);
    color: var(--paper);
    padding: 0.5rem 1rem;
    z-index: 50;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 850px) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
      position: relative;
    }

    .mobile-nav summary {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      color: var(--forest);
      font-weight: 650;
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm, 4px);
      background: color-mix(in srgb, var(--paper) 70%, white);
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav summary::after {
      content: '+';
      font-size: 1.3rem;
      line-height: 1;
      transition: transform 0.2s ease;
    }

    .mobile-nav[open] summary::after {
      transform: rotate(45deg);
    }

    .mobile-nav nav {
      position: absolute;
      right: 0;
      top: calc(100% + 0.65rem);
      width: min(21rem, calc(100vw - 2rem));
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 1.25rem;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius, 8px);
      box-shadow: var(--shadow-elevated);
    }

    .mobile-nav-primary {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .mobile-nav-primary a {
      padding: 0.65rem 0.85rem;
      text-decoration: none;
      color: var(--ink);
      font-weight: 550;
      border-radius: var(--radius-sm, 4px);
      transition: background 0.15s ease;
    }

    .mobile-nav-primary a:hover,
    .mobile-nav-primary a.is-active {
      background: var(--paper-deep);
      color: var(--forest);
    }

    .mobile-booking-link {
      background: var(--forest) !important;
      color: #f4f6f3 !important;
      font-weight: 650 !important;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 0.5rem;
    }

    .mobile-nav-divider {
      height: 1px;
      background: var(--line);
      margin: 0.85rem 0;
    }

    .mobile-nav-secondary {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      font-size: 0.85rem;
    }

    .mobile-call-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--forest);
      font-weight: 600;
      text-decoration: none;
      padding: 0.4rem 0.85rem;
    }

    .mobile-nav-secondary .language {
      padding: 0.4rem 0.85rem;
      color: var(--muted);
      text-decoration: none;
      font-weight: 600;
    }

    .mobile-ota-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0.5rem 0.85rem 0;
    }

    .mobile-ota-links a {
      color: var(--muted);
      font-size: 0.78rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }

    .mobile-ota-links a:hover {
      color: var(--forest);
    }

    .wordmark-sub {
      display: none;
    }
  }
</style>
