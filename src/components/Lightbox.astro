---
import type { Locale } from '../data/types'; import type { Translation } from '../i18n/bg';
const { locale,copy }=Astro.props as {locale:Locale;copy:Translation};
---
<dialog class="lightbox" aria-label={locale === 'bg' ? 'Галерия' : 'Gallery'}><button class="lightbox-close" type="button" aria-label={copy.ui.close}>×</button><button class="lightbox-prev" type="button" aria-label={copy.ui.previous}>‹</button><figure><img alt="" /><figcaption></figcaption></figure><button class="lightbox-next" type="button" aria-label={copy.ui.next}>›</button></dialog>
<script is:inline>
  const dialog=document.querySelector('.lightbox'); const image=dialog?.querySelector('img'); const caption=dialog?.querySelector('figcaption'); let items=[]; let index=0;
  function show(i){if(!dialog||!image)return;index=(i+items.length)%items.length;const a=items[index];image.src=a.href;image.alt=a.dataset.alt||'';if(caption)caption.textContent=a.dataset.caption||'';dialog.showModal();}
  document.querySelectorAll('a[data-lightbox]').forEach((a,i)=>{items.push(a);a.addEventListener('click',e=>{e.preventDefault();show(i)});});
  dialog?.querySelector('.lightbox-close')?.addEventListener('click',()=>dialog.close()); dialog?.querySelector('.lightbox-prev')?.addEventListener('click',()=>show(index-1)); dialog?.querySelector('.lightbox-next')?.addEventListener('click',()=>show(index+1)); dialog?.addEventListener('keydown',e=>{if(e.key==='ArrowRight')show(index+1);if(e.key==='ArrowLeft')show(index-1)}); dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
</script>
<style>.lightbox{width:min(92vw,1000px);max-height:90vh;padding:1rem;background:var(--paper);color:var(--ink);border:1px solid var(--line);box-shadow:var(--shadow)}.lightbox::backdrop{background:rgba(20,30,23,.82)}.lightbox figure{display:grid;place-items:center;margin:1.5rem 3rem}.lightbox img{max-width:100%;max-height:75vh;object-fit:contain}.lightbox figcaption{color:var(--muted);margin-top:.75rem;text-align:center}.lightbox button{position:absolute;border:0;background:transparent;color:inherit;font-size:2.5rem;cursor:pointer}.lightbox-close{top:.25rem;right:.75rem}.lightbox-prev{left:.5rem;top:45%}.lightbox-next{right:.5rem;top:45%}
</style>
