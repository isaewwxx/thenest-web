---
const { label, title, body } = Astro.props as {
  label: string;
  title: string;
  body?: string;
};
---

<div class="section-heading">
  <p class="eyebrow">{label}</p>
  <h2>{title}</h2>
  {body && <p class="prose">{body}</p>}
</div>
<style>
  .section-heading {
    display: grid;
    gap: 0.85rem;
  }
  .section-heading h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 3.6vw, 3.15rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.12;
    max-width: 22ch;
    color: var(--ink);
    margin: 0;
  }
  .section-heading .prose {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }
</style>
