---
import type { Locale } from '../data/types';
import type { Translation } from '../i18n/bg';
import { pathFor } from '../lib/routes';
import {
  Calendar,
  Users,
  User,
  Phone,
  Mail,
  MessageSquare,
  CircleAlert,
  LoaderCircle,
  ArrowUpRight,
  ArrowRight,
  Check,
  ShieldCheck,
} from '@lucide/astro';

interface Props {
  locale: Locale;
  copy: Translation;
}

const { locale, copy } = Astro.props;
const b = copy.booking;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

{turnstileSiteKey && (
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
    is:inline
  ></script>
)}

<div class="booking-panel" id="booking-container">
  <div
    class="booking-notice"
    role="note"
    id="booking-notice"
    data-stay-title={b.disclaimerTitle}
    data-stay-text={b.disclaimerText}
    data-question-title={b.questionDisclaimerTitle}
    data-question-text={b.questionDisclaimerText}
  >
    <ShieldCheck size={20} class="notice-icon" aria-hidden="true" />
    <div>
      <strong id="booking-notice-title">{b.disclaimerTitle}</strong>
      <p id="booking-notice-text">{b.disclaimerText}</p>
    </div>
  </div>

  <form
    class="booking-form"
    id="booking-form"
    method="POST"
    action="/api/booking"
    data-validation={JSON.stringify({
      ...b.validation,
      submitting: b.fields.submitting,
      submittingQuestion: b.fields.submittingQuestion,
      errorTitle: b.error.title,
      errorBody: b.error.body,
      network: b.error.network,
    })}
    data-copy={JSON.stringify({
      legendContact: b.legendContact,
      legendContactQuestion: b.legendContactQuestion,
      messageOptional: b.fields.message,
      messageRequired: b.fields.messageRequired,
      messagePlaceholder: b.fields.messagePlaceholder,
      messageQuestionPlaceholder: b.fields.messageQuestionPlaceholder,
      submit: b.fields.submit,
      submitQuestion: b.fields.submitQuestion,
      successTitle: b.success.title,
      successBody: b.success.body,
      successQuestionTitle: b.success.questionTitle,
      successQuestionBody: b.success.questionBody,
      disclaimerTitle: b.disclaimerTitle,
      disclaimerText: b.disclaimerText,
      questionDisclaimerTitle: b.questionDisclaimerTitle,
      questionDisclaimerText: b.questionDisclaimerText,
    })}
  >
    <!-- Spam Honeypot -->
    <div
      class="sr-only"
      aria-hidden="true"
      style="display:none!important;position:absolute;left:-9999px;"
    >
      <label for="website_trap">Do not fill this</label>
      <input
        type="text"
        name="website_trap"
        id="website_trap"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <!-- Hidden Locale -->
    <input type="hidden" name="locale" value={locale} />

    <!-- Server/Form-level Error Alert -->
    <div
      class="form-alert error-alert"
      id="form-error-alert"
      role="alert"
      style="display: none;"
    >
      <div class="alert-icon" aria-hidden="true">
        <CircleAlert size={20} class="alert-icon-svg" />
      </div>
      <div class="alert-text">
        <strong id="form-error-title">{b.error.title}</strong>
        <p id="form-error-desc">{b.error.body}</p>
      </div>
    </div>

    <fieldset class="form-section intent-section">
      <legend class="section-legend">{b.legendIntent}</legend>
      <div class="intent-toggle" role="radiogroup" aria-label={b.legendIntent}>
        <label class="intent-option">
          <input
            type="radio"
            name="intent"
            value="stay"
            checked
            data-intent-option
          />
          <span class="intent-option-ui">{b.intentStay}</span>
        </label>
        <label class="intent-option">
          <input
            type="radio"
            name="intent"
            value="question"
            data-intent-option
          />
          <span class="intent-option-ui">{b.intentQuestion}</span>
        </label>
      </div>
    </fieldset>

    <div id="stay-fields">
      <fieldset class="form-section">
        <legend class="section-legend">{b.legendDates}</legend>

        <div class="form-row dates-row">
          <div class="form-field">
            <label for="checkIn" class="field-label">
              <Calendar
                size={15}
                stroke-width={2}
                class="field-icon"
                aria-hidden="true"
              />
              <span>{b.fields.checkIn}</span>{' '}
              <span class="required" aria-hidden="true">
                *
              </span>
            </label>
            <input
              type="date"
              id="checkIn"
              name="checkIn"
              required
              class="form-input"
              aria-required="true"
              aria-describedby="checkIn-error"
            />
            <span
              class="field-error"
              id="checkIn-error"
              role="alert"
              style="display: none;"
            ></span>
          </div>

          <div class="form-field">
            <label for="checkOut" class="field-label">
              <Calendar
                size={15}
                stroke-width={2}
                class="field-icon"
                aria-hidden="true"
              />
              <span>{b.fields.checkOut}</span>{' '}
              <span class="required" aria-hidden="true">
                *
              </span>
            </label>
            <input
              type="date"
              id="checkOut"
              name="checkOut"
              required
              class="form-input"
              aria-required="true"
              aria-describedby="checkOut-error"
            />
            <span
              class="field-error"
              id="checkOut-error"
              role="alert"
              style="display: none;"
            ></span>
          </div>
        </div>

        <div class="form-field">
          <label for="guests" class="field-label">
            <Users
              size={15}
              stroke-width={2}
              class="field-icon"
              aria-hidden="true"
            />
            <span>{b.fields.guests}</span>{' '}
            <span class="required" aria-hidden="true">
              *
            </span>
          </label>
          <input
            type="number"
            id="guests"
            name="guests"
            min="1"
            max="18"
            step="1"
            value="2"
            inputmode="numeric"
            required
            class="form-select"
            aria-required="true"
            aria-describedby="guests-help guests-error"
          />
          <span class="field-help" id="guests-help">
            {b.fields.guestsHelp}
          </span>
          <span
            class="field-error"
            id="guests-error"
            role="alert"
            style="display: none;"
          ></span>
        </div>

        <div class="form-field">
          <label for="accommodationPreference" class="field-label">
            <span>{b.fields.accommodationPreference}</span>
          </label>
          <textarea
            id="accommodationPreference"
            name="accommodationPreference"
            rows="2"
            maxlength="300"
            placeholder={b.fields.accommodationPreferencePlaceholder}
            class="form-textarea"
            aria-describedby="accommodationPreference-error"
          ></textarea>
          <span
            class="field-error"
            id="accommodationPreference-error"
            role="alert"
            style="display: none;"
          ></span>
        </div>
      </fieldset>
    </div>

    <fieldset class="form-section">
      <legend class="section-legend" id="contact-legend">
        {b.legendContact}
      </legend>

      <div class="form-field">
        <label for="name" class="field-label">
          <User
            size={15}
            stroke-width={2}
            class="field-icon"
            aria-hidden="true"
          />
          <span>{b.fields.name}</span>{' '}
          <span class="required" aria-hidden="true">
            *
          </span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          placeholder={b.fields.namePlaceholder}
          class="form-input"
          aria-required="true"
          aria-describedby="name-error"
        />
        <span
          class="field-error"
          id="name-error"
          role="alert"
          style="display: none;"
        ></span>
      </div>

      <div class="form-row contact-row">
        <div class="form-field">
          <label for="phone" class="field-label">
            <Phone
              size={15}
              stroke-width={2}
              class="field-icon"
              aria-hidden="true"
            />
            <span>{b.fields.phone}</span>{' '}
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            autocomplete="tel"
            placeholder="+359 888 123 456"
            class="form-input"
            aria-required="false"
            aria-describedby="phone-error"
          />
          <span
            class="field-error"
            id="phone-error"
            role="alert"
            style="display: none;"
          ></span>
        </div>

        <div class="form-field">
          <label for="email" class="field-label">
            <Mail
              size={15}
              stroke-width={2}
              class="field-icon"
              aria-hidden="true"
            />
            <span>{b.fields.email}</span>{' '}
            <span class="required" aria-hidden="true">
              *
            </span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="name@example.com"
            class="form-input"
            aria-required="true"
            aria-describedby="email-error"
          />
          <span
            class="field-error"
            id="email-error"
            role="alert"
            style="display: none;"
          ></span>
        </div>
      </div>

      <div class="form-field">
        <label for="message" class="field-label">
          <MessageSquare
            size={15}
            stroke-width={2}
            class="field-icon"
            aria-hidden="true"
          />
          <span id="message-label-text">{b.fields.message}</span>
          <span
            class="required"
            id="message-required-mark"
            aria-hidden="true"
            hidden
          >
            *
          </span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="3"
          placeholder={b.fields.messagePlaceholder}
          class="form-textarea"
          aria-describedby="message-error"
        ></textarea>
        <span
          class="field-error"
          id="message-error"
          role="alert"
          style="display: none;"
        ></span>
      </div>
    </fieldset>

    <div class="privacy-consent-field">
      <div class="privacy-consent-row">
        <input
          id="privacyAcknowledged"
          name="privacyAcknowledged"
          type="checkbox"
          value="true"
          required
          class="privacy-consent-input"
          aria-required="true"
          aria-describedby="privacyAcknowledged-error"
        />
        <label for="privacyAcknowledged">
          {b.fields.privacyAcknowledgement}
        </label>
      </div>
      <a class="privacy-policy-link" href={pathFor('privacy', locale)}>
        {b.fields.privacyLink}
      </a>
      <span
        class="field-error"
        id="privacyAcknowledged-error"
        role="alert"
        style="display: none;"
      ></span>
    </div>

    {turnstileSiteKey && (
      <div class="turnstile-wrapper">
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="light"
        />
        <span
          class="field-error"
          id="turnstile-error"
          role="alert"
          style="display: none;"
        />
      </div>
    )}

    <div class="form-actions">
      <button type="submit" class="btn btn-primary submit-btn" id="submit-btn">
        <span class="btn-text">{b.fields.submit}</span>
        <span class="btn-spinner" aria-hidden="true" style="display: none;">
          <LoaderCircle size={18} class="animate-spin" />
        </span>
        <span class="btn-arrow" aria-hidden="true">
          <ArrowUpRight size={18} stroke-width={2} />
        </span>
      </button>
      <p class="form-phone-hint">
        <span>{b.phoneCallout}</span>
        <a href="tel:+359877116050" class="text-link phone-link">
          +359 877 116 050
        </a>
      </p>
    </div>
  </form>

  <!-- Polished Success State (Hidden by default) -->
  <div
    class="booking-success"
    id="booking-success"
    style="display: none;"
    role="region"
    aria-live="polite"
  >
    <div class="success-icon" aria-hidden="true">
      <Check size={36} stroke-width={2.5} class="success-icon-svg" />
    </div>
    <h3 id="success-title">{b.success.title}</h3>
    <p class="success-text" id="success-body">
      {b.success.body}
    </p>

    <div class="success-reassurance">
      <h4 id="success-disclaimer-title">{b.disclaimerTitle}</h4>
      <p id="success-disclaimer-text">{b.disclaimerText}</p>
    </div>

    <div class="success-actions">
      <a class="btn btn-primary" href="tel:+359877116050">
        <span>{b.success.callUs}</span>
        <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
      </a>
      <a class="text-link" href={pathFor('home', locale)}>
        <span>{b.success.backHome}</span>
        <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const container = document.getElementById('booking-container');
    const form = document.getElementById('booking-form');
    const successView = document.getElementById('booking-success');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = submitBtn?.querySelector('.btn-text');
    const btnSpinner = submitBtn?.querySelector('.btn-spinner');
    const btnArrow = submitBtn?.querySelector('.btn-arrow');
    const formErrorAlert = document.getElementById('form-error-alert');
    const formErrorTitle = document.getElementById('form-error-title');
    const formErrorDesc = document.getElementById('form-error-desc');

    if (!form || !container) return;

    // Enable client validation progressive enhancement
    form.noValidate = true;

    const stayFields = document.getElementById('stay-fields');
    const contactLegend = document.getElementById('contact-legend');
    const messageLabelText = document.getElementById('message-label-text');
    const messageRequiredMark = document.getElementById(
      'message-required-mark',
    );
    const messageInput = document.getElementById('message');
    const noticeTitle = document.getElementById('booking-notice-title');
    const noticeText = document.getElementById('booking-notice-text');
    const notice = document.getElementById('booking-notice');
    const successTitle = document.getElementById('success-title');
    const successBody = document.getElementById('success-body');
    const successDisclaimerTitle = document.getElementById(
      'success-disclaimer-title',
    );
    const successDisclaimerText = document.getElementById(
      'success-disclaimer-text',
    );

    let uiCopy = {};
    try {
      uiCopy = JSON.parse(form.dataset.copy || '{}');
    } catch (_) {
      uiCopy = {};
    }

    function getIntent() {
      const selected = form.querySelector('input[name="intent"]:checked');
      return selected?.value === 'question' ? 'question' : 'stay';
    }

    function setIntentMode(intent) {
      const isQuestion = intent === 'question';
      if (stayFields) {
        stayFields.hidden = isQuestion;
        stayFields.querySelectorAll('input, select, textarea').forEach((el) => {
          el.disabled = isQuestion;
        });
      }

      if (contactLegend) {
        contactLegend.textContent = isQuestion
          ? uiCopy.legendContactQuestion || contactLegend.textContent
          : uiCopy.legendContact || contactLegend.textContent;
      }

      if (messageLabelText) {
        messageLabelText.textContent = isQuestion
          ? uiCopy.messageRequired || messageLabelText.textContent
          : uiCopy.messageOptional || messageLabelText.textContent;
      }

      if (messageRequiredMark) {
        messageRequiredMark.hidden = !isQuestion;
      }

      if (messageInput) {
        messageInput.required = isQuestion;
        messageInput.setAttribute(
          'aria-required',
          isQuestion ? 'true' : 'false',
        );
        messageInput.placeholder = isQuestion
          ? uiCopy.messageQuestionPlaceholder || messageInput.placeholder
          : uiCopy.messagePlaceholder || messageInput.placeholder;
        messageInput.rows = isQuestion ? 5 : 3;
      }

      if (notice && noticeTitle && noticeText) {
        noticeTitle.textContent = isQuestion
          ? notice.dataset.questionTitle || noticeTitle.textContent
          : notice.dataset.stayTitle || noticeTitle.textContent;
        noticeText.textContent = isQuestion
          ? notice.dataset.questionText || noticeText.textContent
          : notice.dataset.stayText || noticeText.textContent;
      }

      if (btnText) {
        btnText.textContent = isQuestion
          ? uiCopy.submitQuestion || btnText.textContent
          : uiCopy.submit || btnText.textContent;
      }

      if (successTitle && successBody) {
        successTitle.textContent = isQuestion
          ? uiCopy.successQuestionTitle || successTitle.textContent
          : uiCopy.successTitle || successTitle.textContent;
        successBody.textContent = isQuestion
          ? uiCopy.successQuestionBody || successBody.textContent
          : uiCopy.successBody || successBody.textContent;
      }

      if (successDisclaimerTitle && successDisclaimerText) {
        successDisclaimerTitle.textContent = isQuestion
          ? uiCopy.questionDisclaimerTitle || successDisclaimerTitle.textContent
          : uiCopy.disclaimerTitle || successDisclaimerTitle.textContent;
        successDisclaimerText.textContent = isQuestion
          ? uiCopy.questionDisclaimerText || successDisclaimerText.textContent
          : uiCopy.disclaimerText || successDisclaimerText.textContent;
      }
    }

    form.querySelectorAll('[data-intent-option]').forEach((input) => {
      input.addEventListener('change', () => {
        setIntentMode(getIntent());
        clearErrors();
      });
    });

    // 1. Check status and preselect fields from URL query
    try {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('status') === 'success') {
        const hasProof =
          document.cookie.includes('nest_enquiry_ok=1') ||
          sessionStorage.getItem('nest_enquiry_ok') === '1';
        if (hasProof) {
          form.style.display = 'none';
          if (successView) successView.style.display = 'block';
          sessionStorage.removeItem('nest_enquiry_ok');
          document.cookie = 'nest_enquiry_ok=; Path=/; Max-Age=0; SameSite=Lax';
        }
      } else if (urlParams.get('status') === 'error') {
        if (formErrorAlert) formErrorAlert.style.display = 'flex';
      }

      const requestedIntent = urlParams.get('intent');
      if (requestedIntent === 'question' || requestedIntent === 'ask') {
        const questionRadio = form.querySelector(
          'input[name="intent"][value="question"]',
        );
        if (questionRadio) {
          questionRadio.checked = true;
        }
      }

      const requestedGuests = urlParams.get('guests');
      if (requestedGuests) {
        const selectGuests = document.getElementById('guests');
        if (selectGuests) {
          selectGuests.value = requestedGuests;
        }
      }
    } catch (_) {}

    setIntentMode(getIntent());

    // 2. Client-side date min bounds
    const checkInInput = document.getElementById('checkIn');
    const checkOutInput = document.getElementById('checkOut');

    if (checkInInput && checkOutInput) {
      const now = new Date();
      const pad = (n) => String(n).padStart(2, '0');
      const todayStr = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;

      checkInInput.min = todayStr;
      checkOutInput.min = todayStr;

      checkInInput.addEventListener('change', () => {
        if (checkInInput.value) {
          const [year, month, day] = checkInInput.value.split('-').map(Number);
          const inDate = new Date(year, month - 1, day);
          if (!isNaN(inDate.getTime())) {
            inDate.setDate(inDate.getDate() + 1);
            const nextDayStr = `${inDate.getFullYear()}-${pad(inDate.getMonth() + 1)}-${pad(inDate.getDate())}`;
            checkOutInput.min = nextDayStr;
            if (
              checkOutInput.value &&
              checkOutInput.value <= checkInInput.value
            ) {
              checkOutInput.value = nextDayStr;
            }
          }
        } else {
          checkOutInput.min = todayStr;
        }
      });
    }

    // Helper: Clear inline errors
    function clearErrors() {
      if (formErrorAlert) formErrorAlert.style.display = 'none';
      container.querySelectorAll('.field-error').forEach((el) => {
        el.textContent = '';
        el.style.display = 'none';
      });
      container
        .querySelectorAll(
          '.form-input, .form-select, .form-textarea, .privacy-consent-input',
        )
        .forEach((el) => {
          el.removeAttribute('aria-invalid');
          el.classList.remove('has-error');
        });
    }

    // Helper: Show error on a field
    function showFieldError(fieldId, message) {
      const field = document.getElementById(fieldId);
      const errorEl = document.getElementById(`${fieldId}-error`);
      if (field) {
        field.setAttribute('aria-invalid', 'true');
        field.classList.add('has-error');
      }
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.style.display = 'block';
      }
    }

    // 3. Form submission with Progressive Enhancement
    let isSubmitting = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting) return;
      clearErrors();

      // Client-side quick validation
      let hasError = false;
      let firstErrorField = null;
      const intent = getIntent();
      const isQuestion = intent === 'question';

      const messages = JSON.parse(form.dataset.validation || '{}');

      if (!isQuestion) {
        if (!checkInInput.value) {
          showFieldError('checkIn', messages.checkInRequired);
          hasError = true;
          firstErrorField = firstErrorField || checkInInput;
        } else if (checkInInput.value < checkInInput.min) {
          showFieldError('checkIn', messages.checkInPast);
          hasError = true;
          firstErrorField = firstErrorField || checkInInput;
        }

        if (!checkOutInput.value) {
          showFieldError('checkOut', messages.checkOutRequired);
          hasError = true;
          firstErrorField = firstErrorField || checkOutInput;
        } else if (checkOutInput.value < checkOutInput.min) {
          showFieldError('checkOut', messages.checkOutPast);
          hasError = true;
          firstErrorField = firstErrorField || checkOutInput;
        } else if (
          checkInInput.value &&
          checkOutInput.value <= checkInInput.value
        ) {
          showFieldError('checkOut', messages.checkOutAfter);
          hasError = true;
          firstErrorField = firstErrorField || checkOutInput;
        }
      }

      const nameInput = document.getElementById('name');
      if (!nameInput.value.trim() || nameInput.value.trim().length < 2) {
        showFieldError('name', messages.nameRequired);
        hasError = true;
        firstErrorField = firstErrorField || nameInput;
      }

      const phoneInput = document.getElementById('phone');
      const phoneDigits = phoneInput.value.replace(/\D/g, '');
      if (
        phoneInput.value.trim() &&
        (phoneDigits.length < 7 ||
          !/^[\d\s+().-]{7,25}$/.test(phoneInput.value.trim()))
      ) {
        showFieldError('phone', messages.phoneInvalid);
        hasError = true;
        firstErrorField = firstErrorField || phoneInput;
      }

      const emailInput = document.getElementById('email');
      const emailRegex = /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/;
      if (
        !emailInput.value.trim() ||
        !emailRegex.test(emailInput.value.trim())
      ) {
        showFieldError('email', messages.emailRequired);
        hasError = true;
        firstErrorField = firstErrorField || emailInput;
      }

      const privacyAcknowledgedInput = document.getElementById(
        'privacyAcknowledged',
      );
      if (!privacyAcknowledgedInput.checked) {
        showFieldError('privacyAcknowledged', messages.privacyRequired);
        hasError = true;
        firstErrorField = firstErrorField || privacyAcknowledgedInput;
      }

      if (isQuestion) {
        const messageValue = (messageInput?.value || '').trim();
        if (messageValue.length < 5) {
          showFieldError('message', messages.messageRequired);
          hasError = true;
          firstErrorField = firstErrorField || messageInput;
        }
      }

      if (hasError) {
        firstErrorField?.focus();
        return;
      }

      // Collect data
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      data.intent = intent;
      if (isQuestion) {
        delete data.checkIn;
        delete data.checkOut;
        delete data.guests;
      } else {
        data.guests = parseInt(data.guests, 10);
      }

      // Turnstile anti-spam token handling
      const turnstileToken =
        formData.get('cf-turnstile-response') ||
        (typeof window.turnstile !== 'undefined' &&
        typeof window.turnstile.getResponse === 'function'
          ? window.turnstile.getResponse()
          : undefined);
      if (turnstileToken) {
        data.turnstileToken = String(turnstileToken);
        data['cf-turnstile-response'] = String(turnstileToken);
      }

      // Submit state
      isSubmitting = true;
      submitBtn.disabled = true;
      form.setAttribute('aria-busy', 'true');
      if (btnSpinner) btnSpinner.style.display = 'inline-flex';
      if (btnArrow) btnArrow.style.display = 'none';
      const originalText = btnText?.textContent;
      if (btnText) {
        btnText.textContent = isQuestion
          ? messages.submittingQuestion || messages.submitting
          : messages.submitting;
      }

      try {
        const response = await fetch('/api/booking', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok && result.ok) {
          // Success!
          try {
            sessionStorage.setItem('nest_enquiry_ok', '1');
          } catch (_) {}
          form.style.display = 'none';
          if (successView) {
            successView.style.display = 'block';
            successView.scrollIntoView({
              behavior: 'smooth',
              block: 'nearest',
            });
          }
        } else {
          // Server validation errors
          if (result.errors) {
            Object.entries(result.errors).forEach(([field, msg]) => {
              showFieldError(field, msg);
            });
          }
          if (formErrorAlert) {
            if (formErrorTitle)
              formErrorTitle.textContent = messages.errorTitle;
            if (formErrorDesc)
              formErrorDesc.textContent = result.message || messages.errorBody;
            formErrorAlert.style.display = 'flex';
          }
          if (
            typeof window.turnstile !== 'undefined' &&
            typeof window.turnstile.reset === 'function'
          ) {
            try {
              window.turnstile.reset();
            } catch (_) {}
          }
          submitBtn.disabled = false;
          isSubmitting = false;
        }
      } catch (err) {
        if (formErrorAlert) {
          if (formErrorDesc) formErrorDesc.textContent = messages.network;
          formErrorAlert.style.display = 'flex';
        }
        if (
          typeof window.turnstile !== 'undefined' &&
          typeof window.turnstile.reset === 'function'
        ) {
          try {
            window.turnstile.reset();
          } catch (_) {}
        }
        submitBtn.disabled = false;
        isSubmitting = false;
      } finally {
        form.removeAttribute('aria-busy');
        if (btnSpinner) btnSpinner.style.display = 'none';
        if (btnArrow) btnArrow.style.display = 'inline-flex';
        if (btnText && originalText) btnText.textContent = originalText;
      }
    });
  })();
</script>

