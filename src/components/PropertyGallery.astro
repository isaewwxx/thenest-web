---
import DevelopmentImage from './DevelopmentImage.astro'; import Lightbox from './Lightbox.astro'; import type { Locale } from '../data/types'; import type { Translation } from '../i18n/bg'; import type { ImageMetadata } from 'astro'; import alternate from '../assets/development/veranda-study.png';
const {locale,copy,heroImage,full=false}=Astro.props as {locale:Locale;copy:Translation;heroImage:ImageMetadata;full?:boolean}; const alt=locale==='bg'?'Илюстрация на бунгало сред зеленина край морето':'Illustration of a bungalow among greenery by the sea';
---
<div class:list-full={full} class="gallery-grid"><a href={heroImage.src} data-lightbox data-alt={alt} data-caption={copy.ui.illustration}><DevelopmentImage src={heroImage} locale={locale} copy={copy} alt={alt} /></a>{full && <><a class="gallery-placeholder" href={alternate.src} data-lightbox data-alt={alt}><DevelopmentImage src={alternate} locale={locale} copy={copy} alt={alt} /></a><div class="gallery-note"><p>{copy.gallery.notice}</p><p>{copy.gallery.empty}</p></div></>}</div><Lightbox locale={locale} copy={copy} />
<style>.gallery-grid{display:grid;grid-template-columns:1.35fr .8fr;gap:1.4rem;align-items:start}.gallery-grid>a{text-decoration:none;display:block;overflow:hidden}.gallery-grid>a:first-child{grid-row:span 2}.gallery-grid>a:first-child img{aspect-ratio:4/5}.gallery-grid>a:nth-child(2) img{aspect-ratio:4/3}.gallery-grid>a:hover img{transform:scale(1.025);transition:transform .6s ease}.gallery-grid img{transition:transform .6s ease}.gallery-note{padding:1.5rem;border-top:1px solid var(--line);color:var(--muted);align-self:stretch}.gallery-note p{margin:0 0 .8rem}.gallery-grid:not(.list-full){grid-template-columns:1fr}.gallery-grid:not(.list-full)>a:first-child img{aspect-ratio:16/9}@media(max-width:700px){.gallery-grid,.gallery-grid.list-full{grid-template-columns:1fr}.gallery-grid>a:first-child{grid-row:auto}.gallery-grid img,.gallery-grid>a:first-child img{aspect-ratio:4/3}.gallery-note{padding:1rem 0}}
</style>
