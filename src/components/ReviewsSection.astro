---
import SectionHeading from './SectionHeading.astro';
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  copy: import('../i18n/bg').Translation;
}

const { copy } = Astro.props;

const platforms = [
  {
    name: 'Booking.com',
    label: copy.reviews.bookingLink,
    url: 'https://www.booking.com/hotel/bg/bungala-gnezdoto-bungalows-the-nest.bg.html',
  },
  {
    name: 'Airbnb',
    label: copy.reviews.airbnbLink,
    url: 'https://www.airbnb.com/rooms/1518207915595474183',
  },
];
---

<section class="reviews-section container" aria-label={copy.reviews.label}>
  <SectionHeading
    label={copy.reviews.label}
    title={copy.ui.reviews}
    body={copy.reviews.body}
  />
  <div class="platform-links">
    {platforms.map((platform) => (
      <a
        class="platform-link"
        href={platform.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${copy.reviews.body} ${platform.name}`}
      >
        <span>
          <strong>{platform.name}</strong>
          <small>{platform.label}</small>
        </span>
        <ArrowUpRight size={18} stroke-width={2} aria-hidden="true" />
      </a>
    ))}
  </div>
</section>

<style>
  .reviews-section {
    padding: var(--section-y) 0;
  }

  .reviews-section :global(.section-heading) {
    margin-bottom: 2rem;
  }

  .platform-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .platform-link {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .platform-link > span {
    display: grid;
    gap: 0.25rem;
  }

  .platform-link strong {
    color: var(--forest);
    font-size: 1rem;
  }

  .platform-link small {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .platform-link svg {
    flex: none;
    color: var(--muted);
  }

  .platform-link:hover strong,
  .platform-link:hover svg {
    color: var(--forest-dark);
  }

  .platform-link:focus-visible {
    outline: 2px solid var(--sea);
    outline-offset: 4px;
  }

  @media (max-width: 700px) {
    .platform-links {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
