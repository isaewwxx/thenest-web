---
import type { Locale, Review } from '../data/types';
import type { Translation } from '../i18n/bg';
import SectionHeading from './SectionHeading.astro';
import { ArrowUpRight, Star } from '@lucide/astro';

interface Props {
  locale: Locale;
  copy: Translation;
  reviews: readonly Review[];
}

const { locale, copy, reviews } = Astro.props;

// Platform score highlights verified from live public listings
const platformStats = [
  {
    score: '10.0',
    scale: '/ 10',
    title: 'Booking.com',
    subtitle: copy.reviews.bookingSubtitle,
    url: 'https://www.booking.com/hotel/bg/bungala-gnezdoto-bungalows-the-nest.bg.html',
  },
  {
    score: '5.0',
    scale: '/ 5',
    title: 'Airbnb',
    subtitle: copy.reviews.airbnbSubtitle,
    url: 'https://www.airbnb.com/rooms/1528123016093480745',
  },
];
---

<section class="reviews-section container">
  <SectionHeading
    label={copy.reviews.label}
    title={copy.ui.reviews}
    body={copy.reviews.body}
  />

  <div class="stats-grid">
    {platformStats.map((stat) => (
      <a
        href={stat.url}
        target="_blank"
        rel="noopener noreferrer"
        class="stat-card"
        aria-label={`${stat.title} ${stat.score}`}
      >
        <div class="stat-header">
          <span class="platform-badge">{stat.title}</span>
          <ArrowUpRight
            class="external-arrow"
            size={16}
            stroke-width={2}
            aria-hidden="true"
          />
        </div>
        <div class="stat-number">
          <span class="score">{stat.score}</span>
          <span class="scale">{stat.scale}</span>
        </div>
        <p class="stat-desc">{stat.subtitle}</p>
      </a>
    ))}
  </div>

  <div class="reviews-grid">
    {reviews.map((rev) => (
      <article class="review-card">
        <div class="review-header">
          <div class="review-meta">
            <span class="review-author">{rev.author}</span>
            {rev.date && <span class="review-date">{rev.date}</span>}
          </div>
          {rev.rating && (
            <span class="review-score">
              <Star
                size={12}
                stroke-width={2.5}
                class="inline-star"
                aria-hidden="true"
              />
              <span>{rev.rating}</span>
            </span>
          )}
        </div>
        <p class="review-body">{rev.text[locale]}</p>
        <footer class="review-footer">
          {rev.sourceUrl ? (
            <a
              href={rev.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="review-source"
            >
              <span>{rev.source}</span>
              <ArrowUpRight size={13} stroke-width={2} aria-hidden="true" />
            </a>
          ) : (
            <span class="review-source">{rev.source}</span>
          )}
        </footer>
      </article>
    ))}
  </div>
</section>

<style>
  .reviews-section {
    padding: var(--section-y) 0;
  }
  .reviews-section :global(.section-heading) {
    margin-bottom: 3rem;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .stat-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.85rem) 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    word-break: break-word;
    overflow-wrap: anywhere;
    transition: border-color var(--motion-fast) var(--ease-out);
  }
  .stat-card:hover {
    border-color: color-mix(in srgb, var(--forest) 35%, var(--line));
  }
  .stat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .platform-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--forest);
    background: color-mix(in srgb, var(--forest) 8%, var(--paper));
    border: 1px solid color-mix(in srgb, var(--forest) 18%, var(--line));
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm, 4px);
  }
  .external-arrow {
    color: var(--muted);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }
  .stat-card:hover .external-arrow {
    color: var(--forest);
    transform: translate(2px, -2px);
  }
  .stat-number {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }
  .score {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
  }
  .scale {
    font-size: 0.9rem;
    color: var(--muted);
    font-weight: 600;
  }
  .stat-desc {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .review-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.25rem, 3vw, 1.85rem) 0;
    border-top: 1px solid var(--line);
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  .review-card:hover {
    border-color: color-mix(in srgb, var(--forest) 28%, var(--line));
  }
  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .review-meta {
    display: flex;
    flex-direction: column;
  }
  .review-author {
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .review-date {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .review-score {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--forest);
    background: color-mix(in srgb, var(--forest) 8%, var(--paper));
    border: 1px solid color-mix(in srgb, var(--forest) 16%, var(--line));
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm, 4px);
  }
  .inline-star {
    color: #e2a03f;
    fill: #e2a03f;
  }
  .review-body {
    margin: 0 0 1.25rem;
    color: var(--ink);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .review-footer {
    padding-top: 1rem;
    border-top: 1px dashed var(--line);
  }
  .review-source {
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 0.2s ease;
  }
  .review-source:hover {
    color: var(--forest);
  }
  @media (max-width: 850px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
    .reviews-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
