---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBottomBar from '../components/MobileBottomBar.astro';
import { t } from '../i18n';
import { pathFor, type PageKey } from '../lib/routes';
import { seoFor, siteOrigin } from '../lib/content';
import type { Locale } from '../data/types';
import '../styles/global.css';

interface Props {
  locale?: Locale;
  page?: PageKey;
  title?: string;
  description?: string;
}

const { locale = 'bg', page = 'home', title, description } = Astro.props;

const copy = t(locale);
const origin = siteOrigin(import.meta.env.PUBLIC_SITE_URL);
const seo = seoFor(
  page,
  locale,
  origin,
  import.meta.env.PUBLIC_INDEXABLE === 'true',
);
const other = locale === 'bg' ? 'en' : 'bg';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/nest-favicon.svg" type="image/svg+xml" />
    <title>{title ?? copy.meta[page].title}</title>
    <meta
      name="description"
      content={description ?? copy.meta[page].description}
    />
    <meta
      name="robots"
      content={seo.indexable ? 'index,follow' : 'noindex,nofollow'}
    />
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    {seo.bg && <link rel="alternate" hreflang="bg" href={seo.bg} />}
    {seo.en && <link rel="alternate" hreflang="en" href={seo.en} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? copy.meta[page].title} />
    <meta
      property="og:description"
      content={description ?? copy.meta[page].description}
    />
    <meta property="og:locale" content={copy.meta.ogLocale} />
    <meta property="og:site_name" content={copy.footer.brandName} />
    {origin && <meta property="og:url" content={seo.canonical!} />}
    <link
      rel="alternate"
      hreflang={other}
      href={origin ? `${origin}${pathFor(page, other)}` : pathFor(page, other)}
    />
  </head>
  <body>
    <Header locale={locale} page={page} copy={copy} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} page={page} copy={copy} />
    <MobileBottomBar locale={locale} page={page} copy={copy} />
  </body>
</html>
