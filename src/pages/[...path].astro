---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PropertyPhoto from '../components/PropertyPhoto.astro';
import PropertyGallery from '../components/PropertyGallery.astro';
import AccommodationCards from '../components/AccommodationCards.astro';
import ContactMethods from '../components/ContactMethods.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import LocationMap from '../components/LocationMap.astro';
import PageShell from '../components/PageShell.astro';
import PolicyDocument from '../components/PolicyDocument.astro';
import BookingForm from '../components/BookingForm.astro';
import { pages, pathFor, type PageKey } from '../lib/routes';
import { t } from '../i18n';
import { site } from '../data/site';
import { accommodation } from '../data/accommodation';
import type { Locale } from '../data/types';
import { heroPhoto } from '../data/gallery';
import {
  MapPin,
  WavesHorizontal,
  Dog,
  Car,
  House,
  Phone,
  ArrowUpRight,
  ArrowRight,
  Anchor,
  Sun,
} from '@lucide/astro';
import NestMark from '../components/NestMark.astro';

import introPhoto from '../assets/property/exterior/bungalow-twilight-veranda.jpeg';
import atmospherePhoto from '../assets/property/shared/shared-communal-kitchen.jpg';
import locationPhoto from '../assets/property/location/location-sea-view-aerial.jpg';
import accommodationPhoto from '../assets/property/rooms/room-interior-wide.jpeg';
import contactPhoto from '../assets/property/brand/brand-entrance-sign.jpeg';

export function getStaticPaths() {
  return pages.flatMap((page) =>
    ['bg', 'en'].map((locale) => ({
      params: {
        path:
          locale === 'bg'
            ? page === 'home'
              ? undefined
              : page
            : ['en', ...(page === 'home' ? [] : [page])].join('/'),
      },
      props: { page, locale },
    })),
  );
}

const { page, locale } = Astro.props as { page: PageKey; locale: Locale };
const copy = t(locale);

const essentials = [
  {
    icon: MapPin,
    label: copy.home.essentials.location,
  },
  {
    icon: WavesHorizontal,
    label: copy.home.essentials.distance,
  },
  {
    icon: Dog,
    label: copy.home.essentials.pets,
  },
  {
    icon: Car,
    label: copy.home.essentials.parking,
  },
  {
    icon: House,
    label: copy.home.essentials.cabins,
  },
];
---

<BaseLayout locale={locale} page={page}>
  <PageShell locale={locale} copy={copy}>
    {page === 'home' && (
      <>
        <!-- 1. Hero Section -->
        <section class="hero">
          <div class="hero-media">
            <Image
              src={heroPhoto.src}
              alt={heroPhoto.alt[locale]}
              widths={[360, 640, 960, 1280, 1440]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              class="hero-img"
              data-photo-id={heroPhoto.id}
            />
            <div class="hero-wash"></div>
          </div>

          <div class="hero-content container reveal">
            <div class="hero-brand-row">
              <NestMark size={56} class="hero-mark" />
              <h1 class="hero-brand">{copy.home.brand}</h1>
            </div>
            <p class="hero-headline">{copy.home.title}</p>
            <p class="hero-subtext">{copy.home.subtitle}</p>

            <div class="hero-cta-group">
              <a
                class="btn btn-primary hero-primary-btn"
                href={pathFor('booking', locale)}
              >
                <span>{copy.ui.bookingCta}</span>
                <ArrowUpRight
                  class="btn-arrow"
                  size={18}
                  stroke-width={2}
                  aria-hidden="true"
                />
              </a>
              <a
                class="text-link hero-secondary-link"
                href={pathFor('accommodation', locale)}
              >
                <span>{copy.ui.exploreRooms}</span>
                <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            </div>
          </div>
        </section>

        <!-- Quiet essentials (verified facts, not hero chrome) -->
        <div class="essentials-strip">
          <div class="container essentials-inner">
            {essentials.map((item) => {
              const Icon = item.icon;
              return (
                <div class="essentials-item">
                  <span class="essentials-icon" aria-hidden="true">
                    <Icon size={16} stroke-width={2} />
                  </span>
                  <span class="essentials-label">{item.label}</span>
                </div>
              );
            })}
          </div>
        </div>

        <!-- 2. Quiet Editorial Introduction -->
        <section class="intro container section-grid">
          <div class="intro-image">
            <PropertyPhoto
              src={introPhoto}
              alt={copy.home.introPhotoAlt}
              caption={copy.home.introPhotoCaption}
              sizes="(max-width: 640px) 100vw, 50vw"
              focalPoint="48% 42%"
            />
          </div>
          <div class="intro-copy">
            <SectionHeading
              label={copy.home.introLabel}
              title={copy.home.introTitle}
              body={copy.home.introBody}
            />
            <div class="intro-links">
              <a class="text-link" href={pathFor('accommodation', locale)}>
                <span>{copy.ui.explore}</span>
                <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            </div>
          </div>
        </section>

        <!-- 3. Accommodation Section -->
        <section class="stay surface">
          <div class="container">
            <SectionHeading
              label={copy.home.stayLabel}
              title={copy.home.stayTitle}
              body={copy.home.stayBody}
            />
            <div class="stay-content">
              <AccommodationCards
                locale={locale}
                copy={copy}
                units={accommodation}
                showDetails={false}
              />
            </div>
          </div>
        </section>

        <!-- 4. Atmosphere & Outdoor Living -->
        <section class="atmosphere container section-grid">
          <div>
            <SectionHeading
              label={copy.home.atmosphereLabel}
              title={copy.home.atmosphereTitle}
              body={copy.home.atmosphereBody}
            />
            <div class="atmosphere-features">
              <p>{copy.home.atmosphereKitchen}</p>
            </div>
            <div class="atmosphere-links">
              <a class="text-link" href={pathFor('gallery', locale)}>
                <span>{copy.ui.gallery}</span>
                <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            </div>
          </div>
          <div>
            <PropertyPhoto
              src={atmospherePhoto}
              alt={copy.home.atmospherePhotoAlt}
              caption={copy.home.atmospherePhotoCaption}
              sizes="(max-width: 640px) 100vw, 50vw"
              focalPoint="50% 40%"
            />
          </div>
        </section>

        <!-- 5. Curated Gallery Preview -->
        <section class="gallery-preview surface">
          <div class="container">
            <SectionHeading
              label={copy.home.galleryLabel}
              title={copy.home.galleryTitle}
            />
            <PropertyGallery locale={locale} copy={copy} />
            <div class="gallery-more-row">
              <a class="text-link" href={pathFor('gallery', locale)}>
                <span>{copy.ui.gallery}</span>
                <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            </div>
          </div>
        </section>

        <!-- 6. Guest Reviews & Platform Trust -->
        <ReviewsSection copy={copy} />

        <!-- 7. Location Context -->
        <section class="location-preview container">
          <div class="location-card">
            <div>
              <SectionHeading
                label={copy.home.locationLabel}
                title={copy.home.locationTitle}
                body={copy.home.locationBody}
              />
              <div class="location-quick-stats">
                <p>
                  <strong>{copy.ui.beach}:</strong>{' '}
                  {site.location.beach[locale]}
                </p>
                <p>
                  <strong>{copy.ui.parking}:</strong>{' '}
                  {site.location.parking[locale]}
                </p>
              </div>
              <a class="btn btn-primary" href={pathFor('location', locale)}>
                <span>{copy.ui.location}</span>
                <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            </div>
            <div class="location-art">
              <PropertyPhoto
                src={locationPhoto}
                alt={copy.home.locationPhotoAlt}
                caption={copy.home.locationPhotoCaption}
                sizes="(max-width: 640px) 100vw, 50vw"
                focalPoint="55% 40%"
              />
            </div>
          </div>
        </section>

        <!-- 8. Direct Booking CTA Section -->
        <section class="direct-booking-banner">
          <div class="container banner-grid">
            <div class="banner-copy">
              <span class="eyebrow">{copy.booking.label}</span>
              <h2>{copy.home.finalTitle}</h2>
              <p class="banner-desc">{copy.home.bannerDesc}</p>
              <div class="banner-actions">
                <a
                  class="btn btn-primary banner-btn"
                  href={pathFor('booking', locale)}
                >
                  <span>{copy.ui.bookingCta}</span>
                  <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
                </a>
              </div>
              <div class="banner-ota-note">
                <span class="ota-note-title">{copy.booking.otaTitle}</span>
                <div class="ota-inline-links">
                  <a
                    href="https://www.booking.com/hotel/bg/bungala-gnezdoto-bungalows-the-nest.bg.html"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>Booking.com</span>
                    <ArrowUpRight
                      size={14}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </a>
                  <a
                    href="https://www.airbnb.com/rooms/1518207915595474183"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>Airbnb</span>
                    <ArrowUpRight
                      size={14}
                      stroke-width={2}
                      aria-hidden="true"
                    />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      </>
    )}

    {page === 'booking' && (
      <div class="standard-page booking-page">
        <div class="container booking-layout-grid">
          <!-- Main Form Column -->
          <div class="booking-form-col">
            <div class="page-intro booking-intro">
              <p class="eyebrow">{copy.booking.label}</p>
              <h1>{copy.booking.title}</h1>
              <p class="lead">{copy.booking.lead}</p>
            </div>

            <BookingForm locale={locale} copy={copy} />
          </div>

          <!-- Side Info Column -->
          <aside class="booking-sidebar">
            <div class="sidebar-block host-block">
              <p class="sidebar-eyebrow">
                {copy.booking.sidebar.directContactTitle}
              </p>
              <p class="sidebar-desc">
                {copy.booking.sidebar.directContactDesc}
              </p>
              <a href="tel:+359877116050" class="sidebar-tel">
                <Phone size={18} stroke-width={2} aria-hidden="true" />
                <span>+359 877 116 050</span>
              </a>
              <div class="sidebar-address">
                <span class="sidebar-address-item">
                  <MapPin size={16} stroke-width={2} aria-hidden="true" />
                  <span>{site.location.address[locale]}</span>
                </span>
                <span class="sidebar-address-item">
                  <WavesHorizontal
                    size={16}
                    stroke-width={2}
                    aria-hidden="true"
                  />
                  <span>{copy.booking.sidebar.distanceSmallBeach}</span>
                </span>
              </div>
            </div>

            <div class="sidebar-block policies-block">
              <p class="sidebar-eyebrow">{copy.booking.policiesTitle}</p>
              <ul class="sidebar-policy-list" role="list">
                <li>
                  <strong>{copy.booking.sidebar.checkInLabel}</strong>
                  <span>{site.policies.checkIn[locale]}</span>
                </li>
                <li>
                  <strong>{copy.booking.sidebar.checkOutLabel}</strong>
                  <span>{site.policies.checkOut[locale]}</span>
                </li>
                <li>
                  <strong>{copy.booking.sidebar.quietHoursLabel}</strong>
                  <span>{copy.booking.sidebar.quietHoursValue}</span>
                </li>
                <li>
                  <strong>{copy.booking.sidebar.petsLabel}</strong>
                  <span>{copy.booking.sidebar.petsValue}</span>
                </li>
                <li>
                  <strong>{copy.booking.sidebar.parkingLabel}</strong>
                  <span>{copy.booking.sidebar.parkingValue}</span>
                </li>
              </ul>
            </div>

            <div class="sidebar-block ota-block">
              <p class="sidebar-eyebrow">{copy.booking.otaTitle}</p>
              <p class="sidebar-desc">{copy.booking.otaDesc}</p>
              <div class="sidebar-ota-links">
                <a
                  class="text-link"
                  href="https://www.booking.com/hotel/bg/bungala-gnezdoto-bungalows-the-nest.bg.html"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{copy.ui.bookOnBooking}</span>
                  <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
                </a>
                <a
                  class="text-link"
                  href="https://www.airbnb.com/rooms/1518207915595474183"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{copy.ui.bookOnAirbnb}</span>
                  <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    )}

    {page === 'accommodation' && (
      <div class="standard-page accommodation-page">
        <div class="container page-intro">
          <p class="eyebrow">{copy.accommodation.label}</p>
          <h1>{copy.accommodation.title}</h1>
          <p class="lead">{copy.accommodation.lead}</p>
        </div>

        <div class="container accommodation-story">
          <div class="accommodation-story-media">
            <PropertyPhoto
              src={accommodationPhoto}
              alt={copy.accommodation.pagePhotoAlt}
              caption={copy.accommodation.pagePhotoCaption}
              sizes="(max-width: 800px) 100vw, 48vw"
              focalPoint="50% 45%"
            />
          </div>
          <div class="accommodation-story-copy">
            <SectionHeading
              label={copy.accommodation.label}
              title={copy.accommodation.title2}
              body={copy.accommodation.body}
            />
          </div>
        </div>

        <div class="container accommodation-units">
          <AccommodationCards
            locale={locale}
            copy={copy}
            units={accommodation}
          />
        </div>
      </div>
    )}

    {page === 'gallery' && (
      <div class="standard-page">
        <div class="container page-intro">
          <p class="eyebrow">{copy.gallery.label}</p>
          <h1>{copy.gallery.title}</h1>
          <p class="lead">{copy.gallery.lead}</p>
        </div>
        <div class="container gallery-page">
          <PropertyGallery locale={locale} copy={copy} full />
        </div>
      </div>
    )}

    {page === 'location' && (
      <div class="standard-page">
        <div class="container page-intro">
          <p class="eyebrow">{copy.location.label}</p>
          <h1>{copy.location.title}</h1>
          <p class="lead">{copy.location.lead}</p>
        </div>
        <div class="container location-page">
          <div class="location-visual">
            <PropertyPhoto
              src={locationPhoto}
              alt={copy.location.photoAlt}
              caption={copy.location.photoCaption}
            />
            <div class="location-neighborhood-card">
              <h3 class="neighborhood-title">
                {copy.location.walkingDistancesTitle}
              </h3>
              <ul class="neighborhood-list" role="list">
                <li>
                  <span class="place-icon" aria-hidden="true">
                    <WavesHorizontal size={18} stroke-width={2} />
                  </span>
                  <div class="place-info">
                    <strong>{copy.location.places.smallBeach}</strong>
                    <span>{copy.location.places.smallBeachDistance}</span>
                  </div>
                </li>
                <li>
                  <span class="place-icon" aria-hidden="true">
                    <Anchor size={18} stroke-width={2} />
                  </span>
                  <div class="place-info">
                    <strong>{copy.location.places.fishingPort}</strong>
                    <span>{copy.location.places.fishingPortDistance}</span>
                  </div>
                </li>
                <li>
                  <span class="place-icon" aria-hidden="true">
                    <House size={18} stroke-width={2} />
                  </span>
                  <div class="place-info">
                    <strong>{copy.location.places.villageCenter}</strong>
                    <span>{copy.location.places.villageCenterDistance}</span>
                  </div>
                </li>
                <li>
                  <span class="place-icon" aria-hidden="true">
                    <Sun size={18} stroke-width={2} />
                  </span>
                  <div class="place-info">
                    <strong>{copy.location.places.centralBeach}</strong>
                    <span>{copy.location.places.centralBeachDistance}</span>
                  </div>
                </li>
                <li>
                  <span class="place-icon" aria-hidden="true">
                    <Car size={18} stroke-width={2} />
                  </span>
                  <div class="place-info">
                    <strong>{copy.location.places.parking}</strong>
                    <span>{copy.location.places.parkingDesc}</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
          <div class="location-copy">
            <SectionHeading
              label={copy.location.label}
              title={copy.location.title2}
              body={copy.location.body}
            />
            <div class="location-details">
              <h3>{copy.location.travelTitle}</h3>
              <p>{copy.location.travelBody}</p>
              <h3>{copy.ui.beach}</h3>
              <p>{site.location.beach[locale]}</p>
              <h3>{copy.ui.parking}</h3>
              <p>{site.location.parking[locale]}</p>
              <h3>{copy.location.region}</h3>
              <p>{copy.location.regionBody}</p>
            </div>
            <LocationMap
              locale={locale}
              externalMapUrl={site.location.googleMapsUrl}
            />
          </div>
        </div>
      </div>
    )}

    {page === 'contact' && (
      <div class="standard-page">
        <div class="container page-intro">
          <p class="eyebrow">{copy.contact.label}</p>
          <h1>{copy.contact.title}</h1>
          <p class="lead">{copy.contact.lead}</p>
        </div>
        <div class="container contact-page">
          <div>
            <PropertyPhoto
              src={contactPhoto}
              alt={copy.contact.photoAlt}
              caption={copy.contact.photoCaption}
            />
          </div>
          <div>
            <SectionHeading
              label={copy.contact.label}
              title={copy.contact.title2}
              body={
                site.contacts.phone || site.contacts.email
                  ? copy.contact.ready
                  : copy.contact.pending
              }
            />
            <ContactMethods
              locale={locale}
              copy={copy}
              contacts={site.contacts}
            />
            <p class="contact-note">{copy.contact.note}</p>

            <div class="contact-booking-callout">
              <a class="btn btn-primary" href={pathFor('booking', locale)}>
                <span>{copy.ui.bookingCta}</span>
                <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            </div>

            <div class="contact-next">
              <h3>{copy.contact.planTitle}</h3>
              <p>{copy.contact.planBody}</p>
              <a class="text-link" href={pathFor('location', locale)}>
                <span>{copy.ui.location}</span>
                <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    {(page === 'privacy' ||
      page === 'cookies' ||
      page === 'booking-terms' ||
      page === 'house-rules') && (
      <PolicyDocument locale={locale} page={page} copy={copy} />
    )}
  </PageShell>
</BaseLayout>

<style>
  /* Hero Section — photo-first, brand signal */
  .hero {
    position: relative;
    min-height: clamp(560px, 92svh, 860px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #f3f5f2;
    background: #15231e;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
    display: block;
    transform: scale(1.02);
    animation: hero-ken 18s ease-out both;
  }

  @keyframes hero-ken {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1.02);
    }
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 30, 26, 0.28) 0%,
      rgba(18, 30, 26, 0.18) 32%,
      rgba(16, 28, 24, 0.62) 68%,
      rgba(14, 24, 20, 0.9) 100%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: clamp(4rem, 12vw, 8rem);
    padding-bottom: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .hero-brand-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .hero-brand-row :global(.nest-mark) {
    --nest-mark-size: 3.25rem;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.35));
  }

  .hero-brand {
    font-family: var(--font-heading);
    max-width: 12ch;
    font-size: clamp(2.85rem, 6.5vw, 5rem);
    font-weight: 650;
    color: #f3f5f2;
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin: 0;
    text-wrap: balance;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.4);
  }

  .hero-headline {
    font-family: var(--font-heading);
    max-width: 20ch;
    font-size: clamp(1.35rem, 2.6vw, 1.95rem);
    font-weight: 500;
    color: rgba(243, 245, 242, 0.96);
    line-height: 1.28;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    text-wrap: balance;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.32);
  }

  .hero-subtext {
    font-family: var(--font-sans);
    font-size: clamp(1.02rem, 1.7vw, 1.22rem);
    max-width: 34ch;
    color: rgba(243, 245, 242, 0.9);
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.85rem;
  }

  .hero-primary-btn {
    min-height: 3.15rem;
    padding: 0.8rem 1.55rem;
    font-size: 1rem;
    font-weight: 650;
    border-radius: var(--radius, 8px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
  }

  .hero-secondary-link.text-link {
    color: #f4f6f3;
    font-weight: 600;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.55),
      0 0 18px rgba(0, 0, 0, 0.35);
  }

  .hero-secondary-link.text-link:hover {
    color: #ffffff;
  }

  .hero-secondary-link.text-link :global(svg) {
    color: currentColor;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.45));
  }

  .essentials-strip {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: clamp(0.95rem, 2.2vw, 1.25rem) 0;
  }

  .essentials-inner {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.85rem 1.25rem;
    align-items: start;
  }

  .essentials-item {
