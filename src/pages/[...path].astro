---
import BaseLayout from '../layouts/BaseLayout.astro'; import SectionHeading from '../components/SectionHeading.astro'; import DevelopmentImage from '../components/DevelopmentImage.astro'; import PropertyGallery from '../components/PropertyGallery.astro'; import AccommodationCards from '../components/AccommodationCards.astro'; import ContactMethods from '../components/ContactMethods.astro'; import PageShell from '../components/PageShell.astro'; import { pages, pathFor, type PageKey } from '../lib/routes'; import { t } from '../i18n'; import { site } from '../data/site'; import { accommodation } from '../data/accommodation'; import type { Locale } from '../data/types'; import hero from '../assets/development/coastal-study.png'; import veranda from '../assets/development/veranda-study.png'; import leaves from '../assets/development/leaves-study.png';
export function getStaticPaths(){ return pages.flatMap((page)=>['bg','en'].map((locale)=>({params:{path:locale==='bg' ? (page==='home' ? undefined : page) : ['en',...(page==='home'?[]:[page])].join('/')},props:{page,locale}}))); }
const { page,locale }=Astro.props as {page:PageKey;locale:Locale}; const copy=t(locale);
const leadAlt=locale==='bg'?'Илюстрация на дървено бунгало сред зеленина и море':'Illustration of a wooden bungalow among greenery and sea'; const verandaAlt=locale==='bg'?'Илюстрация на веранда сред зеленина':'Illustration of a veranda among greenery'; const leavesAlt=locale==='bg'?'Илюстрация на крайморска зеленина':'Illustration of coastal greenery';
---
<BaseLayout locale={locale} page={page}>
<PageShell locale={locale} copy={copy}>
{page === 'home' && <>
  <section class="hero"><div class="hero-media"><img src={hero.src} alt={leadAlt} fetchpriority="high" width={hero.width} height={hero.height} /><div class="hero-wash"></div></div><div class="hero-copy container"><p class="eyebrow">{copy.home.eyebrow}</p><h1>{copy.home.title}</h1><p>{copy.home.subtitle}</p><div class="hero-actions"><a class="btn btn-primary" href={pathFor('contact',locale)}>{copy.ui.enquire}<span aria-hidden="true">↗</span></a><a class="text-link" href={pathFor('gallery',locale)}>{copy.ui.gallery}<span aria-hidden="true">→</span></a></div></div><div class="hero-note">{copy.ui.illustration}</div></section>
  <section class="intro container section-grid"><div class="intro-image"><DevelopmentImage src={veranda} locale={locale} copy={copy} alt={verandaAlt}/></div><div class="intro-copy"><SectionHeading label={copy.home.introLabel} title={copy.home.introTitle} body={copy.home.introBody}/><a class="text-link" href={pathFor('location',locale)}>{copy.ui.location}<span aria-hidden="true">→</span></a></div></section>
  <section class="stay surface"><div class="container"><SectionHeading label={copy.home.stayLabel} title={copy.home.stayTitle} body={copy.home.stayBody}/><div class="stay-content"><AccommodationCards locale={locale} copy={copy} units={accommodation}/><a class="btn btn-outline" href={pathFor('accommodation',locale)}>{copy.ui.explore}<span aria-hidden="true">→</span></a></div></div></section>
  <section class="atmosphere container section-grid"><div><SectionHeading label={copy.home.atmosphereLabel} title={copy.home.atmosphereTitle} body={copy.home.atmosphereBody}/><div class="atmosphere-links"><a class="text-link" href={pathFor('gallery',locale)}>{copy.ui.gallery}<span aria-hidden="true">→</span></a><a class="text-link" href={pathFor('contact',locale)}>{copy.ui.enquire}<span aria-hidden="true">→</span></a></div></div><div><DevelopmentImage src={leaves} locale={locale} copy={copy} alt={leavesAlt}/></div></section>
  <section class="gallery-preview surface"><div class="container"><SectionHeading label={copy.home.galleryLabel} title={copy.home.galleryTitle}/><PropertyGallery locale={locale} copy={copy} heroImage={hero}/></div></section>
  <section class="location-preview container"><div class="location-card"><div><SectionHeading label={copy.home.locationLabel} title={copy.home.locationTitle} body={copy.home.locationBody}/><a class="btn btn-primary" href={pathFor('location',locale)}>{copy.ui.location}<span aria-hidden="true">↗</span></a></div><div class="location-art"><DevelopmentImage src={leaves} locale={locale} copy={copy} alt={leavesAlt}/><span class="location-marker">{site.location.locality[locale]}</span></div></div></section>
  <section class="final-cta"><div class="container"><p class="eyebrow">{copy.home.finalTitle}</p><h2>{copy.home.finalBody}</h2><a class="btn btn-primary" href={pathFor('contact',locale)}>{copy.ui.contact}<span aria-hidden="true">↗</span></a></div></section>
</>}
{page === 'accommodation' && <div class="standard-page"><div class="container page-intro"><p class="eyebrow">{copy.accommodation.label}</p><h1>{copy.accommodation.title}</h1><p class="lead">{copy.accommodation.lead}</p></div><div class="container detail-grid"><div><DevelopmentImage src={veranda} locale={locale} copy={copy} alt={verandaAlt}/></div><div><SectionHeading label={copy.accommodation.label} title={copy.accommodation.title2} body={copy.accommodation.body}/><AccommodationCards locale={locale} copy={copy} units={accommodation}/></div></div></div>}
{page === 'gallery' && <div class="standard-page"><div class="container page-intro"><p class="eyebrow">{copy.gallery.label}</p><h1>{copy.gallery.title}</h1><p class="lead">{copy.gallery.lead}</p></div><div class="container gallery-page"><PropertyGallery locale={locale} copy={copy} heroImage={hero} full /></div></div>}
{page === 'location' && <div class="standard-page"><div class="container page-intro"><p class="eyebrow">{copy.location.label}</p><h1>{copy.location.title}</h1><p class="lead">{copy.location.lead}</p></div><div class="container location-page"><div class="location-map"><div class="map-shape"><span>{site.location.locality[locale]}</span><i></i></div><p>{copy.location.diagram}</p></div><div class="location-copy"><SectionHeading label={copy.location.label} title={copy.location.title2} body={copy.location.body}/><div class="location-details"><h3>{copy.location.travelTitle}</h3><p>{copy.location.travelBody}</p><h3>{copy.location.region}</h3><p>{copy.location.regionBody}</p>{site.location.googleMapsUrl && <a class="btn btn-outline" href={site.location.googleMapsUrl}>{copy.ui.maps}</a>}</div></div></div></div>}
{page === 'contact' && <div class="standard-page"><div class="container page-intro"><p class="eyebrow">{copy.contact.label}</p><h1>{copy.contact.title}</h1><p class="lead">{copy.contact.lead}</p></div><div class="container contact-page"><div><DevelopmentImage src={veranda} locale={locale} copy={copy} alt={verandaAlt}/></div><div><SectionHeading label={copy.contact.label} title={copy.contact.title2} body={site.contacts.phone || site.contacts.email ? copy.contact.ready : copy.contact.pending}/><ContactMethods locale={locale} copy={copy} contacts={site.contacts}/><p class="contact-note">{copy.contact.note}</p><div class="contact-next"><h3>{copy.contact.planTitle}</h3><p>{copy.contact.planBody}</p><a class="text-link" href={pathFor('location',locale)}>{copy.ui.location}<span aria-hidden="true">→</span></a></div></div></div></div>}
</PageShell></BaseLayout>
<style>
.page-shell{overflow:hidden}.hero{position:relative;min-height:min(760px,calc(100dvh - 5.5rem));display:flex;align-items:flex-end;color:#f9f7ed;background:#21362a}.hero-media,.hero-media img,.hero-wash{position:absolute;inset:0;width:100%;height:100%}.hero-media img{object-fit:cover}.hero-wash{background:linear-gradient(90deg,rgba(20,38,27,.78),rgba(20,38,27,.15) 70%,rgba(20,38,27,.03))}.hero-copy{position:relative;padding:clamp(5rem,14vw,10rem) 1.25rem}.hero-copy h1{max-width:9ch;font-size:clamp(3.4rem,8vw,7.8rem);color:#f7f4e9}.hero-copy>p:not(.eyebrow){font-size:clamp(1.15rem,2vw,1.45rem);max-width:28ch;color:#f1f0e7}.hero-actions{display:flex;align-items:center;gap:1.5rem;margin-top:2rem}.text-link{display:inline-flex;gap:.55rem;align-items:center;color:var(--forest);font-weight:650;text-decoration:none}.hero .text-link{color:#f7f4e9}.text-link span{transition:transform .3s}.text-link:hover span{transform:translateX(4px)}.hero-note{position:absolute;right:1.25rem;bottom:1rem;font-size:.7rem;color:rgba(255,255,255,.75)}.section-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,8vw,9rem);align-items:center;padding-top:clamp(5rem,10vw,10rem);padding-bottom:clamp(5rem,10vw,10rem)}.intro-copy{display:grid;gap:2rem}.intro-image{margin-left:clamp(0rem,7vw,8rem)}.intro-image img{aspect-ratio:4/5}.stay{padding:clamp(5rem,9vw,8rem) 0}.stay .section-heading{max-width:700px}.stay-content{display:grid;gap:2.5rem;margin-top:3rem;max-width:800px}.atmosphere-links{display:flex;gap:1.5rem;margin-top:2rem}.gallery-preview{padding:clamp(5rem,9vw,8rem) 0}.gallery-preview .section-heading{margin-bottom:3rem}.location-preview{padding:clamp(5rem,10vw,10rem) 0}.location-card{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,8rem);align-items:center}.location-card .section-heading{margin-bottom:2rem}.location-art{position:relative}.location-art img{aspect-ratio:1/1}.location-marker{position:absolute;left:1rem;bottom:1rem;background:var(--paper);padding:.65rem 1rem;color:var(--forest);font:500 1.3rem Lora,serif}.final-cta{padding:clamp(5rem,10vw,9rem) 0;background:var(--forest);color:var(--paper)}.final-cta h2{font-size:clamp(2.5rem,6vw,6rem);max-width:10ch;margin:1rem 0 2rem}.final-cta .eyebrow{color:#b8cb8d}.standard-page{padding-bottom:clamp(5rem,10vw,10rem)}.page-intro{padding-top:clamp(5rem,10vw,9rem);padding-bottom:clamp(4rem,8vw,7rem)}.page-intro h1{font-size:clamp(3rem,7vw,6.8rem);max-width:10ch;margin:.8rem 0 1.2rem}.lead{max-width:36ch;color:var(--muted);font-size:1.25rem}.detail-grid,.location-page,.contact-page{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,8vw,9rem);align-items:start}.detail-grid .section-heading{margin-bottom:2rem}.gallery-page{max-width:1050px}.location-map{padding:1.5rem;background:var(--paper-deep)}.map-shape{position:relative;aspect-ratio:1.15;background:linear-gradient(145deg,#bdd0b1,#e6dfbe 48%,#a6c8c4 49%,#86a9a8);overflow:hidden;display:grid;place-items:center}.map-shape:before,.map-shape:after{content:'';position:absolute;border:1px solid rgba(37,77,58,.32);border-radius:50%;width:60%;height:50%;transform:rotate(-20deg)}.map-shape:after{width:90%;height:70%;transform:rotate(15deg)}.map-shape span{position:relative;z-index:1;background:var(--paper);padding:.7rem 1rem;font:500 1.8rem Lora,serif;color:var(--forest)}.map-shape i{position:absolute;width:1.2rem;height:1.2rem;border-radius:50%;background:var(--wood);border:4px solid var(--paper);left:55%;top:50%;z-index:2}.location-map>p{font-size:.8rem;color:var(--muted);margin:.8rem 0 0}.location-copy .section-heading{margin-bottom:3rem}.location-details{border-top:1px solid var(--line);padding-top:1.5rem}.location-details h3{font-size:1.4rem;margin-top:1.5rem}.location-details p{color:var(--muted);max-width:48ch}.contact-page .section-heading{margin-bottom:2rem}.contact-note{font-size:.82rem;color:var(--muted);margin-top:1.2rem}.contact-next{border-top:1px solid var(--line);margin-top:3rem;padding-top:1.5rem}.contact-next h3{font-size:1.4rem}.contact-next p{color:var(--muted)}
@media(max-width:700px){.hero{min-height:calc(100dvh - 5.5rem);align-items:flex-end}.hero-copy{padding:5rem 1.25rem 4rem}.hero-copy h1{font-size:clamp(3.2rem,16vw,5rem)}.hero-wash{background:linear-gradient(0deg,rgba(20,38,27,.82),rgba(20,38,27,.1) 85%)}.section-grid,.location-card,.detail-grid,.location-page,.contact-page{grid-template-columns:1fr;gap:3rem}.section-grid{padding-top:5rem;padding-bottom:5rem}.intro-image{margin:0}.intro-copy{order:-1}.location-card{gap:2rem}.page-intro{padding-top:5rem;padding-bottom:4rem}.page-intro h1{font-size:clamp(3rem,15vw,5rem)}.final-cta h2{font-size:3.2rem}.gallery-preview{padding:5rem 0}.hero-actions{flex-wrap:wrap}.hero-note{bottom:.5rem;font-size:.65rem}}
</style>
