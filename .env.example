# ==============================================================================
# The Nest / Гнездото — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Origin & SEO Indexing
# ------------------------------------------------------------------------------
# Owner-approved production origin URL without trailing slash (e.g. https://thenest-lozenets.com).
# Leave empty in local development to avoid emitting absolute canonical URLs.
PUBLIC_SITE_URL=

# Control search engine crawling via robots.txt and meta robots tags.
# Set to 'true' for the approved, verified production domain; keep previews false.
# Default: false
PUBLIC_INDEXABLE=false

# ------------------------------------------------------------------------------
# 2. Transactional Email via Resend (Serverless / Server-side)
# ------------------------------------------------------------------------------
# API key from Resend (https://resend.com) for dispatching transactional booking enquiry emails.
# In local development, if left empty, enquiries run in simulation mode and log to console.
RESEND_API_KEY=

# Property owner inbox receiving alert notifications for new booking enquiries.
# Default recipient for booking enquiry notifications.
BOOKING_RECIPIENT_EMAIL=gnezdoto.lozenets@gmail.com

# Verified sender address for outgoing notification and guest acknowledgment emails.
# Must be a domain verified in your Resend account (e.g. 'The Nest <reservations@yourdomain.com>').
# For development testing without domain verification, Resend sandbox address can be used:
# 'The Nest <onboarding@resend.dev>'
BOOKING_FROM_EMAIL=booking@thenestlozenets.eu

# ------------------------------------------------------------------------------
# 3. Cloudflare Turnstile Anti-Spam Protection
# ------------------------------------------------------------------------------
# Server-side secret key from Cloudflare Turnstile dashboard used to verify tokens.
# When omitted, Turnstile verification is bypassed gracefully (ideal for dev/testing).
# Alternative alias accepted: CF_TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=

# Client-side site key from Cloudflare Turnstile dashboard.
# When provided, the Turnstile verification widget and challenge script are rendered in BookingForm.astro.
# When omitted, the booking form operates in standard accessible mode without blocking submissions.
# When PUBLIC_TURNSTILE_SITE_KEY is set, also set TURNSTILE_SECRET_KEY.
# Site key alone shows the widget but cannot verify tokens server-side.
PUBLIC_TURNSTILE_SITE_KEY=
